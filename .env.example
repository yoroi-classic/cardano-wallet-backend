# Which Cardano network the backend serves. One of: mainnet, preprod, preview.
NETWORK=preprod

# HTTP server
PORT=3010
HOST=0.0.0.0
LOG_LEVEL=info

# Primary chain-data provider. koios and blockfrost are wired; dingo is planned and will
# fail fast if selected before its driver lands.
PROVIDER=koios

# Cache the chain-wide reads (tip, protocol parameters). These are identical for every caller,
# so serving them from upstream on every request makes our load on the provider scale with our
# user count for no benefit. Account-scoped reads (balance, UTxOs, history, tx status) are never
# cached at any setting; see src/providers/cached.ts.
#
# Set to false only to debug upstream. Anything other than an explicit "false" leaves it on.
CACHE_ENABLED=true

# Browser origins allowed to call the API. "*" (the default) allows any.
#
# CORS is not a security control for this service: the API is public, unauthenticated and
# read-only, so an attacker just calls it from a server, where CORS does not apply. It is here
# because browsers demand the headers. The extension calls from an opaque chrome-extension://<id>
# origin that changes per build, which is why the default is a wildcard rather than a list we
# would have to keep chasing. Revisit when account tokens land.
CORS_ORIGINS=*

# Anonymous free tier, per client IP. 0 disables the limiter entirely, which is only correct on a
# private deployment. The limiter keeps a transient in-memory counter per IP; it is never logged
# and never joined to what was asked for (see src/http/logging.ts).
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Comma-separated exact IP addresses or CIDR ranges of reverse proxies allowed to supply the
# client IP in X-Forwarded-For. Empty is the safe default for the directly exposed Docker port:
# caller-supplied forwarding headers are ignored. Configure only addresses your deployment owns.
# Nothing wider than a /8 is accepted, in either family.
TRUST_PROXY=

# Koios (https://koios.rest). Leave this unset so the URL is chosen from NETWORK above.
# Only set it to point at a specific Koios instance (self-hosted, or a different tier).
# preprod: https://preprod.koios.rest/api/v1
# mainnet: https://api.koios.rest/api/v1
# KOIOS_URL=https://preprod.koios.rest/api/v1
# Optional bearer token for higher Koios rate limits. Leave blank for the free tier.
KOIOS_TOKEN=

# NFTCDN (https://nftcdn.io), for native-asset media.
#
# Optional, and both or neither. Without it every chain read still works and only the media
# routes answer 503; a client can fall back to the raw on-chain image URI (usually ipfs://) that
# /v1/assets/info already returns, and resolve it through a gateway of its own.
#
# The subdomain is the network name on preprod and preview, and an account-specific one on
# mainnet. The key is base64, exactly as the NFTCDN dashboard gives it.
#
# NFTCDN_KEY IS A SECRET. It never leaves this process: the backend signs URLs and hands the
# signed URLs to the wallet. A key shipped inside an extension or an app would be extracted
# within the hour, and whoever pulled it could serve their own bandwidth on our account.
# NFTCDN_SUBDOMAIN=preprod
# NFTCDN_KEY=

# Client remote config: feature flags, the dApp list, banners.
#
# Defaults to OUR fork (yoroi-classic/yoroi-config), and that default is the whole point. Whoever
# controls this file controls what our users see: a banner, the dApp list, or nothing at all if it
# is deleted. It used to be Emurgo's repository.
#
# Serving it from here also stops a wallet handing its IP to a git host on every single launch,
# which would sit oddly beside the trouble we go to not to write that down ourselves.
#
# Set to an empty string to turn the endpoint off. It is on by default because a wallet that
# cannot read its config is a wallet that will not finish starting.
# CONFIG_URL=https://raw.githubusercontent.com/yoroi-classic/yoroi-config/refs/heads/main/prod.json

# Blockfrost (https://blockfrost.io). Leave BLOCKFROST_URL unset so it is chosen from NETWORK
# above, one of Blockfrost's own hosted endpoints:
# preprod: https://cardano-preprod.blockfrost.io/api/v0
# mainnet: https://cardano-mainnet.blockfrost.io/api/v0
# Only set it to point at something else: a self-hosted Dingo node running in Blockfrost's
# emulation mode is the case this is built for, and needs no project id.
# BLOCKFROST_URL=https://cardano-preprod.blockfrost.io/api/v0
#
# BLOCKFROST_PROJECT_ID is Blockfrost's auth token, sent as a `project_id` request header.
# Required only when PROVIDER=blockfrost above; startup fails loudly if it is missing then.
# Currently covers chain tip/params, stake-account state/UTxOs, tx submit/status, and the
# used-address check. Asset, governance, and pool reads, plus full tx history, are not yet
# implemented on this provider and answer 501 until a follow-up lands.
# BLOCKFROST_PROJECT_ID=

# Dingo config lands here once that driver arrives.
# DINGO_BLOCKFROST_URL=
# DINGO_UTXORPC_URL=
