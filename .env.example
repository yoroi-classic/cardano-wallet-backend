# Which Cardano network the backend serves. One of: mainnet, preprod, preview.
NETWORK=preprod

# HTTP server
PORT=3010
HOST=0.0.0.0
LOG_LEVEL=info

# Primary chain-data provider. Only koios is wired today; blockfrost and dingo are
# planned and will fail fast if selected before their drivers land.
PROVIDER=koios

# Koios (https://koios.rest). Leave this unset so the URL is chosen from NETWORK above.
# Only set it to point at a specific Koios instance (self-hosted, or a different tier).
# preprod: https://preprod.koios.rest/api/v1
# mainnet: https://api.koios.rest/api/v1
# KOIOS_URL=https://preprod.koios.rest/api/v1
# Optional bearer token for higher Koios rate limits. Leave blank for the free tier.
KOIOS_TOKEN=

# Blockfrost and Dingo config land here as those drivers arrive.
# BLOCKFROST_URL=
# BLOCKFROST_PROJECT_ID=
# DINGO_BLOCKFROST_URL=
# DINGO_UTXORPC_URL=
