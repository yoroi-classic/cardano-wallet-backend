# The running backend to drive.
BACKEND_URL=http://localhost:3010

# Which network the backend is serving.
NETWORK=preprod

# Mainnet can spend real ADA and requires this exact, separate opt-in.
# Leave unset for preprod and preview.
# ALLOW_MAINNET_E2E=true

# A test-only 15 or 24 word mnemonic. NEVER use a mnemonic that holds real funds.
MNEMONIC="word word word ... word"

# How much to send to self, in lovelace (default 1 ADA).
AMOUNT_LOVELACE=1000000

# Confirmations to wait for, and how often to poll.
CONFIRMATIONS=1
POLL_SECONDS=10
